   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "fs = 250\n",
    "time = np.arange(0,5,1/fs)\n",
    "signal = np.sin(2*np.pi*10*time)\n",
    "\n",
    "plt.plot(time,signal)\n",
    "plt.xlabel(\"Time(s)\")\n",
    "plt.ylabel(\"Amplitude\")\n",
    "\n",
    "plt.show()"
   ]
  },
